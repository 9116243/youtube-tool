{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "resolveJsonModule": true,
    "strict": true,

    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": ".tsbuild/node"
  },
  "include": [
    "vite.config.ts",
    "tailwind.config.ts",
    "postcss.config.cjs",
    "scripts/**/*.ts"
  ]
}
