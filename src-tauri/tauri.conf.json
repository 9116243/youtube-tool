{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YouTube Helper AI",
  "version": "0.1.0",
  "identifier": "com.youtube.helper.ai",

  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },

  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "YouTube Helper AI",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "center": true,
        "visible": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self' http://localhost:1420 ws://localhost:1420; img-src 'self' asset: data: blob:; media-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval' http://localhost:1420; connect-src 'self' http://localhost:1420 ws://localhost:1420;"
    }
  },

  "bundle": {
    "resources": ["binaries/ffmpeg.exe", "binaries/yt-dlp.exe"]
  }
}
