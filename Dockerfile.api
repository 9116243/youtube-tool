# syntax=docker/dockerfile:1

FROM node:20-slim
WORKDIR /app
COPY server_v2/package.json ./package.json
COPY server_v2/package-lock.json* ./ || true
RUN npm i --omit=dev
COPY server_v2/. .
RUN npm run build
ENV NODE_ENV=production \
    PORT=3001
RUN mkdir -p workspace data
EXPOSE 3001
CMD ["node", "dist/server.js"]
