{
  "name": "enterprise-youtube-suite",
  "private": true,
  "version": "1.0.0",
  "description": "Enterprise-grade YouTube operations suite built with React, Vite, Tailwind, and shadcn/ui.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "typecheck": "tsc --noEmit",
    "mock": "node mock/server.js",
    "mock:server": "node mock/server.js",
    "tsc:web": "tsc -p tsconfig.web.json"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.1",
    "@radix-ui/react-dropdown-menu": "2.1.1",
    "@radix-ui/react-label": "2.1.0",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "2.1.2",
    "@radix-ui/react-separator": "1.0.3",
    "@radix-ui/react-slot": "1.0.2",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "axios": "1.7.9",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dayjs": "^1.11.19",
    "express-rate-limit": "^7.1.6",
    "framer-motion": "11.11.12",
    "i18next": "^25.6.1",
    "i18next-browser-languagedetector": "^8.2.0",
    "lucide-react": "0.451.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "^16.2.4",
    "react-router-dom": "6.27.0",
    "tailwind-merge": "2.5.5",
    "tailwindcss-animate": "1.0.7",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@types/express-rate-limit": "^5.1.3",
    "@types/i18next": "^12.1.0",
    "@types/node": "20.17.17",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "8.18.2",
    "@typescript-eslint/parser": "8.18.2",
    "@vitejs/plugin-react-swc": "3.7.1",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-react-hooks": "4.6.2",
    "eslint-plugin-react-refresh": "0.4.8",
    "node-fetch": "^3.3.2",
    "postcss": "8.4.49",
    "prettier": "3.4.2",
    "tailwindcss": "3.4.17",
    "typescript": "^5.7.3",
    "vite": "5.4.11"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "packageManager": "pnpm@9.12.2"
}